# GitHub personal access token, read-only scope is sufficient.
# Optional: the poller works unauthenticated at this project's call volume,
# but a token avoids sharing the unauthenticated rate-limit ceiling with
# other traffic from the same IP.
GITHUB_TOKEN=

# Postgres connection string (Neon or Supabase free tier both work fine).
# Required by scripts/init_db.py and anything touching the DB.
DATABASE_URL=

# Google AI Studio API key (Gemini, free tier). Required by
# src/gemini_client.py.
GEMINI_API_KEY=

# Fine-grained GitHub PAT, scoped ONLY to issue-triaging-agent-digests,
# with Issues: Read and write permission and nothing else — deliberately
# a separate credential from GITHUB_TOKEN (which is read-only, scoped by
# convention to scikit-learn polling). Required for publishing digests
# (see "Digest & publish" in the README's pipeline table).
SHADOW_REPO_TOKEN=

# Shared secret required in the X-Trigger-Token header to call POST
# /trigger — that endpoint spends real Gemini/GitHub API calls
# and posts a real issue, so it can't be left open. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
TRIGGER_SECRET=
