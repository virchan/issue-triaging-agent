# GitHub personal access token, read-only scope is sufficient.
# Optional: the poller works unauthenticated at this project's call volume
# (see LOG.md entry 8), but a token avoids sharing the unauthenticated
# rate-limit ceiling with other traffic from the same IP.
GITHUB_TOKEN=

# Postgres connection string (Neon or Supabase free tier — see LOG.md
# entry 6). Required by scripts/init_db.py and anything touching the DB.
DATABASE_URL=

# Google AI Studio API key (Gemini, free tier — see LOG.md entry 1).
# Required by src/gemini_client.py.
GEMINI_API_KEY=

# Fine-grained GitHub PAT, scoped ONLY to issue-triaging-agent-digests,
# with Issues: Read and write permission and nothing else — deliberately
# a separate credential from GITHUB_TOKEN (which is read-only, scoped by
# convention to scikit-learn polling). Required for publishing digests
# (Step 17).
SHADOW_REPO_TOKEN=

# Shared secret required in the X-Trigger-Token header to call POST
# /trigger (Step 20) — that endpoint spends real Gemini/GitHub API calls
# and posts a real issue, so it can't be left open. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
TRIGGER_SECRET=
