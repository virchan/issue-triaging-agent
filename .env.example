# GitHub personal access token, read-only scope is sufficient.
# Optional: the poller works unauthenticated at this project's call volume
# (see LOG.md entry 8), but a token avoids sharing the unauthenticated
# rate-limit ceiling with other traffic from the same IP.
GITHUB_TOKEN=

# Postgres connection string (Neon or Supabase free tier — see LOG.md
# entry 6). Required by scripts/init_db.py and anything touching the DB.
DATABASE_URL=
